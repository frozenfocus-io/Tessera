# Zielbau Etappe 4b (Zwischenstand): Fachwerkhaus mit Vorkragung, Kreuzgiebel, Gauben, Erker und Feld.
# Koordinaten: x nach Osten, y nach oben, z nach Süden. Der Boden draußen liegt bei y=-1.
tess 2
projekt "Fachwerkhaus"
samen 7

rolle stein cobblestone:4 mossy_cobblestone:1 stone:2 muster=flecken:2
rolle sockel stone_bricks:4 mossy_stone_bricks:1 cracked_stone_bricks:1
rolle putz calcite
rolle balken dark_oak_log
rolle holz dark_oak_planks
rolle rahmen spruce_planks
rolle dach deepslate_tiles
rolle glas glass_pane
rolle laden spruce_trapdoor
rolle tuer spruce_door
rolle ziegel bricks
rolle erde rooted_dirt

# ---- Grundriss in Kreuzform: Langhaus (x) und Querhaus (z), Erdgeschoss aus Stein
box fundament 0,-1,0 20,0,8 sockel
box querfundament 7,-1,-3 13,0,11 sockel
box eg 0,1,0 20,6,8 stein hohl boden=holz
box quereg 7,1,-3 13,6,11 stein hohl boden=holz

# Obergeschoss in Fachwerk; das Langhaus kragt vorne und hinten einen Block vor
box og 0,7,-1 20,12,9 putz hohl fachwerk=balken raster=4 riegel=1 muster=strebe boden=holz
box querog 7,7,-3 13,12,11 putz hohl fachwerk=balken raster=6 riegel=1 muster=strebe boden=holz

# Wo sich Lang- und Querhaus kreuzen, fallen die Innenwände weg
leer 8,2,0 12,6,0
leer 8,2,8 12,6,8
leer 7,2,1 7,6,7
leer 13,2,1 13,6,7
leer 8,8,-1 12,12,-1
leer 8,8,9 12,12,9
leer 7,8,0 7,12,8
leer 13,8,0 13,12,8

# Kopfbänder unter der Vorkragung
strebe 0,6,9 richtung=s laenge=1 holz
strebe 4,6,9 richtung=s laenge=1 holz
strebe 16,6,9 richtung=s laenge=1 holz
strebe 20,6,9 richtung=s laenge=1 holz
strebe 0,6,-1 richtung=n laenge=1 holz
strebe 4,6,-1 richtung=n laenge=1 holz
strebe 16,6,-1 richtung=n laenge=1 holz
strebe 20,6,-1 richtung=n laenge=1 holz

# Erker mit Helm vorne links: er reicht durch die Traufe, sein Helm steht vor dem Dach
erker og s y=9 x=1 b=5 h=5 art=halbrund rahmen dach=helm name=erker
fenster erker s y=10 b=1 h=2 bank=nein sturz=nein

# ---- Kreuzgiebel: zwei Satteldächer, die sich kreuzen
dach sattel og first=x giebel=rahmen
dach sattel querog first=z giebel=rahmen
fenster querog s y=14 b=1 h=2 bank=nein sturz=nein
fenster querog n y=14 b=1 h=2 bank=nein sturz=nein

# Zwei Gauben, vorne rechts und hinten links
gaube og s x=17 laeden=laden
gaube og n x=3 laeden=laden


# Schornstein an der Westseite: Steinfuß, darüber Ziegel
box kaminfuss -2,-1,3 -1,3,5 sockel
box schornstein -2,4,3 -1,21,4 ziegel

# ---- Tür im Querhaus mit Vordach und Stufen, Laternen daneben
tür quereg s stufen=2 vordach=holz
wandlaterne quereg s y=4 versatz=-2 arm=holz
wandlaterne quereg s y=4 versatz=2 arm=holz

# Fenster mit Läden und Blumenkästen
fenster eg s y=2 b=2 x=3 laeden=laden
fenster eg s y=2 b=2 x=16 laeden=laden
fenster eg n y=2 b=2 x=3 laeden=laden
fenster eg n y=2 b=2 x=16 laeden=laden
fenster eg o y=2 b=2 laeden=laden
fenster quereg n y=2 b=2 laeden=laden
fenster og s y=9 b=3 x=17 laeden=laden kasten=erde blumen=poppy,dandelion,cornflower
fenster querog s y=9 b=3 laeden=laden kasten=erde blumen=cornflower,poppy,allium
fenster querog n y=9 b=3 laeden=laden kasten=erde blumen=allium,poppy,oxeye_daisy
fenster og n y=9 b=3 x=17 laeden=laden kasten=erde blumen=dandelion,azure_bluet,poppy
fenster og o y=9 b=3 z=4 laeden=laden

# ---- Feld mit Zaun und Tor daneben
feld 24,-1,0 32,-1,8 frucht=wheat zaun=holz tor=w weg=dirt_path
